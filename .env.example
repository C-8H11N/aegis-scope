# Copy to .env only in your own environment. Never commit secrets.
AEGISSCOPE_DATA_DIR=./var
AEGISSCOPE_SSH_ALIAS=kali-src
AEGISSCOPE_REMOTE_ROOT=~/src-runner
AEGISSCOPE_LANGUAGE=zh-CN

# Optional OpenAI-compatible planning API. The planner only creates proposals.
AEGISSCOPE_LLM_BASE_URL=https://api.example.invalid/v1
AEGISSCOPE_LLM_API_KEY=
AEGISSCOPE_LLM_MODEL=
